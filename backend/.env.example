# Configuración de Base de Datos para Eos Protección
# Si deseas conectar tu instancia de PostgreSQL, descomenta la siguiente línea y ajusta las credenciales:
# DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/eos_proteccion

# Por defecto, el sistema funciona de inmediato con SQLite local sin requerir configuración adicional:
DATABASE_URL=sqlite:///./eos_proteccion.db
